# pyiwfm multi-page report style
# Tuned for 8.5x11 US Letter portrait with manual axes placement.
# Constrained_layout OFF — headers/footers use manual fig.add_axes().
# Smaller base fonts for denser page content.

# Typography — sans-serif ONLY (ADA/Section 508 compliance)
font.family:        sans-serif
font.sans-serif:    Arial, Helvetica, DejaVu Sans
font.size:          8

# Figure — exact US Letter page
figure.constrained_layout.use: False
figure.figsize:     8.5, 11
figure.dpi:         150
savefig.dpi:        300
savefig.bbox:       standard

# Axes (Tufte minimalism: remove non-data spines)
axes.spines.top:    False
axes.spines.right:  False
axes.linewidth:     0.6
axes.edgecolor:     333333
axes.labelcolor:    333333
axes.labelsize:     9
axes.titlesize:     10
axes.titleweight:   bold
axes.titlepad:      6

# Ticks
xtick.labelsize:    7
ytick.labelsize:    7
xtick.direction:    out
ytick.direction:    out
xtick.major.size:   3.5
ytick.major.size:   3.5
xtick.major.width:  0.6
ytick.major.width:  0.6
xtick.color:        333333
ytick.color:        333333

# Grid (subtle, y-axis only)
axes.grid:          True
axes.grid.axis:     y
grid.color:         D0D0D0
grid.linewidth:     0.4
grid.alpha:         0.5

# Lines
lines.linewidth:    1.0
lines.markersize:   4
patch.linewidth:    0.5

# Legend (Tufte: no frame)
legend.frameon:     False
legend.fontsize:    7
legend.handlelength: 1.5

# PDF font embedding (required for ADA accessibility)
pdf.fonttype:       42
ps.fonttype:        42

# Okabe-Ito colorblind-safe color cycle
axes.prop_cycle: cycler('color', ['0072B2', 'E69F00', '009E73', 'D55E00', 'CC79A7', '56B4E9', 'F0E442', '000000'])
